# Global storage for mock server state tracking
last_request_method = None
last_request_path = None
last_request_body = None
last_request_content_type = None
last_request_headers = None
mock_response_payload = {}
mock_response_status_code = 200
mock_response_body_delay = 0.0


class MockThanosHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Suppress logging to keep unittest output clean
        return

    def handle_request(self, method):
        global last_request_method, last_request_path, last_request_body, last_request_content_type, last_request_headers, mock_response_payload, mock_response_status_code, mock_response_body_delay
        last_request_method = method
        last_request_path = self.path
        last_request_content_type = self.headers.get("Content-Type")
        # self.headers is an email.message.Message: header lookups are
        # case-insensitive, unlike a plain dict, which matters here since
        # urllib.request title-cases header names on the wire.
        last_request_headers = self.headers

        if method == "POST":
            content_length = int(self.headers.get("Content-Length", 0))
            last_request_body = self.rfile.read(content_length).decode("utf-8")
        else:
            last_request_body = None

        self.send_response(mock_response_status_code)

        if isinstance(mock_response_payload, (str, bytes)):
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            if isinstance(mock_response_payload, str):
                body = mock_response_payload.encode("utf-8")
            else:
                body = mock_response_payload
        else:
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            body = json.dumps(mock_response_payload).encode("utf-8")

        if mock_response_body_delay > 0:
            time.sleep(mock_response_body_delay)

        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        self.handle_request("GET")

    def do_POST(self):
        self.handle_request("POST")


# Configure mock HTTP server on a dynamically assigned free TCP port
mock_server = HTTPServer(("localhost", 0), MockThanosHandler)
MOCK_PORT = mock_server.server_port
MOCK_THANOS_URL = f"http://localhost:{MOCK_PORT}"

# Start serving in a background daemon thread
t = threading.Thread(target=mock_server.serve_forever, daemon=True)
t.start()


def run_tq(args, env_override=None, set_thanos_url=True):
    env = dict(os.environ)
    if set_thanos_url:
        env["THANOS_URL"] = MOCK_THANOS_URL
    for key, value in (env_override or {}).items():
        if value is None:
            env.pop(key, None)
        else:
            env[key] = value

    cmd = [sys.executable, os.path.join(os.path.dirname(__file__), "tq")] + args
    result = subprocess.run(cmd, env=env, capture_output=True, text=True)
    return result


def write_config(profiles, guidance=None, version=1, mode=0o600):
    """Writes a temp config.json under a fresh temp dir and returns the dir,
    suitable for passing as XDG_CONFIG_HOME in env_override."""
    tmpdir = tempfile.mkdtemp()
    os.makedirs(os.path.join(tmpdir, "tq"))
    path = os.path.join(tmpdir, "tq", "config.json")
    data = {"version": version, "profiles": profiles}
    if guidance is not None:
        data["guidance"] = guidance
    with open(path, "w") as f:
        json.dump(data, f)
    os.chmod(path, mode)
    return tmpdir


def write_raw_config(content, mode=0o600):
    """Like write_config but writes arbitrary (possibly malformed) text."""
    tmpdir = tempfile.mkdtemp()
    os.makedirs(os.path.join(tmpdir, "tq"))
    path = os.path.join(tmpdir, "tq", "config.json")
    with open(path, "w") as f:
        f.write(content)
    os.chmod(path, mode)
    return tmpdir


