class TestTqProfiles(unittest.TestCase):
    def setUp(self):
        global last_request_method, last_request_path, last_request_body, last_request_content_type, last_request_headers, mock_response_payload, mock_response_status_code, mock_response_body_delay
        last_request_method = None
        last_request_path = None
        last_request_body = None
        last_request_content_type = None
        last_request_headers = None
        mock_response_payload = {"status": "success", "data": {"resultType": "vector", "result": []}}
        mock_response_status_code = 200
        mock_response_body_delay = 0.0
        self._tmpdirs = []

    def tearDown(self):
        import shutil
        for d in self._tmpdirs:
            shutil.rmtree(d, ignore_errors=True)

    def config_env(self, profiles, guidance=None, **kwargs):
        tmpdir = write_config(profiles, guidance=guidance, **kwargs)
        self._tmpdirs.append(tmpdir)
        return {"XDG_CONFIG_HOME": tmpdir, "THANOS_URL": None}

    def raw_config_env(self, content, **kwargs):
        tmpdir = write_raw_config(content, **kwargs)
        self._tmpdirs.append(tmpdir)
        return {"XDG_CONFIG_HOME": tmpdir, "THANOS_URL": None}

    # --- resolution ---

    def test_profile_missing_config_file(self):
