    def test_list_profiles_rejects_every_request_option(self):
        # Regression: --list-profiles/--show-profile must reject *every*
        # request-related flag, not just query/mode flags -- previously
        # `tq --list-profiles --raw-response --header-file /missing
        # --http-timeout 1` silently ignored everything after --list-profiles
        # and succeeded.
        rejected_invocations = [
            ["--list-profiles", "--start", "100"],
            ["--list-profiles", "--end", "200"],
            ["--list-profiles", "--step", "5m"],
            ["--list-profiles", "--since", "5m"],
            ["--list-profiles", "--time", "100"],
            ["--list-profiles", "--query-timeout", "10s"],
            ["--list-profiles", "--http-timeout", "1"],
            ["--list-profiles", "--raw-response"],
            ["--list-profiles", "--header", "X: y"],
            ["--list-profiles", "--header-file", "/definitely/missing"],
            ["--list-profiles", "--url", "http://example.invalid"],
            ["--show-profile", "x", "--raw-response"],
            ["--show-profile", "x", "--header-file", "/definitely/missing"],
        ]
        for args in rejected_invocations:
            with self.subTest(args=args):
                res = run_tq(args)
                self.assertEqual(res.returncode, 2, f"expected rejection for {args}, got stdout={res.stdout!r}")
                self.assertIn("takes no query", res.stderr)

