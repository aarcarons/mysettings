# Machine-specific identity (name, email, signing key) lives in the untracked ~/.gitconfig.local
[include]
    path = .git_aliases
    path = .gitconfig.local

[core]
    pager = delta
    editor = code --wait
    excludesfile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    features = line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[fetch]
    prune = true

[rerere]
    enabled = true

[url "git@github.com:"]
    insteadOf = https://github.com/

[log]
    date = iso-local

[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[rebase]
    autoStash = true
	autosquash = true
	updateRefs = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[branch]
	sort = -committerdate
