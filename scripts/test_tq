#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import threading
import unittest
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer

# Global storage for mock server state tracking
last_request_method = None
last_request_path = None
last_request_body = None
last_request_content_type = None
mock_response_payload = {}
mock_response_status_code = 200


class MockThanosHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Suppress logging to keep unittest output clean
        return

    def handle_request(self, method):
        global last_request_method, last_request_path, last_request_body, last_request_content_type, mock_response_payload, mock_response_status_code
        last_request_method = method
        last_request_path = self.path
        last_request_content_type = self.headers.get("Content-Type")

        if method == "POST":
            content_length = int(self.headers.get("Content-Length", 0))
            last_request_body = self.rfile.read(content_length).decode("utf-8")
        else:
            last_request_body = None

        self.send_response(mock_response_status_code)

        if isinstance(mock_response_payload, (str, bytes)):
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            if isinstance(mock_response_payload, str):
                body = mock_response_payload.encode("utf-8")
            else:
                body = mock_response_payload
        else:
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            body = json.dumps(mock_response_payload).encode("utf-8")

        self.wfile.write(body)

    def do_GET(self):
        self.handle_request("GET")

    def do_POST(self):
        self.handle_request("POST")


# Configure mock HTTP server on a dynamically assigned free TCP port
mock_server = HTTPServer(("localhost", 0), MockThanosHandler)
MOCK_PORT = mock_server.server_port
MOCK_THANOS_URL = f"http://localhost:{MOCK_PORT}"

# Start serving in a background daemon thread
t = threading.Thread(target=mock_server.serve_forever, daemon=True)
t.start()


def run_tq(args, env_override=None):
    env = dict(os.environ)
    env["THANOS_URL"] = MOCK_THANOS_URL
    if env_override:
        env.update(env_override)

    cmd = [sys.executable, "scripts/tq"] + args
    result = subprocess.run(cmd, env=env, capture_output=True, text=True)
    return result


class TestTqCommandLine(unittest.TestCase):
    def setUp(self):
        global last_request_method, last_request_path, last_request_body, last_request_content_type, mock_response_payload, mock_response_status_code
        last_request_method = None
        last_request_path = None
        last_request_body = None
        last_request_content_type = None
        mock_response_payload = {"status": "success", "data": {}}
        mock_response_status_code = 200

    def test_validation_step_requires_range(self):
        res = run_tq(["--step", "5m", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--step requires --range", res.stderr)

    def test_validation_start_requires_valid_mode(self):
        res = run_tq(["--start", "12345", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--start requires --range", res.stderr)

    def test_validation_end_requires_valid_mode(self):
        res = run_tq(["--end", "12345", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--end requires --range", res.stderr)

    def test_validation_time_only_valid_on_instant_query(self):
        res = run_tq(["--range", "--time", "123", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--time is only valid for instant queries", res.stderr)

    def test_routing_labels_missing_selector(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": ["__name__", "instance", "job"],
        }
        res1 = run_tq(["--labels"])
        self.assertEqual(res1.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/labels")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        # Omitted selector means match[] parameter must be absent
        qs1 = urllib.parse.parse_qs(last_request_body)
        self.assertNotIn("match[]", qs1)

        # Whitespace-only selector should behave identically
        res2 = run_tq(["--labels", "   "])
        self.assertEqual(res2.returncode, 0)
        qs2 = urllib.parse.parse_qs(last_request_body)
        self.assertNotIn("match[]", qs2)

    def test_routing_label_values_missing_selector(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": ["value-1", "value-2"],
        }
        res1 = run_tq(["--label-values", "__name__"])
        self.assertEqual(res1.returncode, 0)
        self.assertEqual(last_request_method, "GET")
        self.assertTrue(last_request_path.startswith("/api/v1/label/__name__/values"))

        # Omitted selector means match[] parameter must be absent
        parsed1 = urllib.parse.urlparse(last_request_path)
        qs1 = urllib.parse.parse_qs(parsed1.query)
        self.assertNotIn("match[]", qs1)

        # Whitespace-only selector should behave identically
        res2 = run_tq(["--label-values", "__name__", "   "])
        self.assertEqual(res2.returncode, 0)
        parsed2 = urllib.parse.urlparse(last_request_path)
        qs2 = urllib.parse.parse_qs(parsed2.query)
        self.assertNotIn("match[]", qs2)

    def test_validation_label_values_missing_label(self):
        res = run_tq(["--label-values"])
        self.assertEqual(res.returncode, 2)
        # Argparse error for expected one argument
        self.assertIn("expected one argument", res.stderr)

    def test_validation_label_values_empty_label(self):
        res = run_tq(["--label-values", "", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--label-values requires a non-empty label name", res.stderr)

    def test_validation_label_values_whitespace_label(self):
        res = run_tq(["--label-values", "   ", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--label-values requires a non-empty label name", res.stderr)

    def test_validation_stores_takes_no_query(self):
        res1 = run_tq(["--stores", "some_unexpected_query"])
        self.assertEqual(res1.returncode, 2)
        self.assertIn("--stores takes no query/selector expression", res1.stderr)

        res2 = run_tq(["--stores", "   "])
        self.assertEqual(res2.returncode, 2)
        self.assertIn("--stores takes no query/selector expression", res2.stderr)

    def test_validation_since_invalid_duration(self):
        res = run_tq(["--range", "--since", "30", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("expected duration like 30s, 5m, 2h, 1d, or 1w", res.stderr)

    def test_validation_since_fractional_duration(self):
        res = run_tq(["--range", "--since", "0.5s", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("expected duration like 30s, 5m, 2h, 1d, or 1w", res.stderr)

    def test_validation_since_zero_duration(self):
        res = run_tq(["--range", "--since", "0m", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("duration must be greater than zero", res.stderr)

    def test_validation_since_unsupported_unit(self):
        res = run_tq(["--range", "--since", "5min", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("expected duration like 30s, 5m, 2h, 1d, or 1w", res.stderr)

    def test_validation_since_cannot_combine_with_start_or_end(self):
        res1 = run_tq(["--range", "--since", "5m", "--start", "100", "up"])
        self.assertEqual(res1.returncode, 2)
        self.assertIn("--since cannot be combined with --start or --end", res1.stderr)

        res2 = run_tq(["--range", "--since", "5m", "--end", "200", "up"])
        self.assertEqual(res2.returncode, 2)
        self.assertIn("--since cannot be combined with --start or --end", res2.stderr)

    def test_validation_since_requires_valid_mode(self):
        res = run_tq(["--since", "5m", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--since requires --range, --series, --labels, or --label-values", res.stderr)

    def test_validation_http_timeout_zero(self):
        res = run_tq(["--http-timeout", "0", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("timeout must be a finite positive number", res.stderr)

    def test_validation_http_timeout_negative(self):
        res = run_tq(["--http-timeout", "-5.5", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("timeout must be a finite positive number", res.stderr)

    def test_validation_http_timeout_nan(self):
        res = run_tq(["--http-timeout", "nan", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("timeout must be a finite positive number", res.stderr)

    def test_validation_http_timeout_inf(self):
        res = run_tq(["--http-timeout", "inf", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("timeout must be a finite positive number", res.stderr)

    def test_validation_http_timeout_non_numeric(self):
        res = run_tq(["--http-timeout", "abc", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("timeout must be a positive number", res.stderr)

    def test_validation_query_timeout_only_valid_for_instant_or_range(self):
        res = run_tq(["--series", "--query-timeout", "10s", "up"])
        self.assertEqual(res.returncode, 2)
        self.assertIn("--query-timeout is only valid for instant or range queries", res.stderr)

    def test_routing_range_query_with_since(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": {
                "resultType": "matrix",
                "result": [{"metric": {"__name__": "up"}, "values": [[1234.56, "1"]]}],
            },
        }
        # 5m = 300s duration
        res = run_tq(["--range", "--since", "5m", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query_range")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        start = int(qs.get("start")[0])
        end = int(qs.get("end")[0])
        # end - start should equal exactly 300 seconds
        self.assertEqual(end - start, 300)

    def test_routing_series_query_with_since(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": [],
        }

        res = run_tq(["--series", "--since", "5m", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/series")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        start = int(qs.get("start")[0])
        end = int(qs.get("end")[0])
        # end - start should equal exactly 300 seconds
        self.assertEqual(end - start, 300)

    def test_routing_instant_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": {
                "resultType": "vector",
                "result": [{"metric": {"__name__": "up"}, "value": [1234.56, "1"]}],
            },
        }
        res = run_tq(["up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        # Check parameter in POST body
        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("query"), ["up"])

        # Check normalized response
        data = json.loads(res.stdout)
        self.assertEqual(len(data), 1)
        self.assertEqual(data[0]["metric"]["__name__"], "up")

    def test_routing_instant_query_with_time(self):
        global mock_response_payload
        mock_response_payload = {"status": "success", "data": {"resultType": "vector", "result": []}}
        res = run_tq(["--time", "1234567890", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("time"), ["1234567890"])

    def test_routing_instant_query_with_query_timeout(self):
        global mock_response_payload
        mock_response_payload = {"status": "success", "data": {"resultType": "vector", "result": []}}
        res = run_tq(["--query-timeout", "10s", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("timeout"), ["10s"])

    def test_routing_range_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": {
                "resultType": "matrix",
                "result": [{"metric": {"__name__": "up"}, "values": [[1234.56, "1"]]}],
            },
        }
        res = run_tq(["--range", "--step", "5m", "--start", "100", "--end", "200", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query_range")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("query"), ["up"])
        self.assertEqual(qs.get("step"), ["5m"])
        self.assertEqual(qs.get("start"), ["100"])
        self.assertEqual(qs.get("end"), ["200"])

    def test_routing_range_query_with_query_timeout(self):
        global mock_response_payload
        mock_response_payload = {"status": "success", "data": {"resultType": "matrix", "result": []}}
        res = run_tq(["--range", "--query-timeout", "30s", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query_range")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("timeout"), ["30s"])

    def test_routing_series_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": [{"__name__": "up", "instance": "localhost"}],
        }
        res = run_tq(["--series", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/series")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("match[]"), ["up"])
        # start and end must be absent if not supplied
        self.assertNotIn("start", qs)
        self.assertNotIn("end", qs)

        # Check normalization (preserves complete data array)
        data = json.loads(res.stdout)
        self.assertEqual(data, [{"__name__": "up", "instance": "localhost"}])

    def test_routing_labels_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": ["__name__", "instance", "job"],
        }
        res = run_tq(["--labels", "--start", "100", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/labels")
        self.assertEqual(last_request_content_type, "application/x-www-form-urlencoded")

        qs = urllib.parse.parse_qs(last_request_body)
        self.assertEqual(qs.get("match[]"), ["up"])
        self.assertEqual(qs.get("start"), ["100"])
        self.assertNotIn("end", qs)

        # Check normalization (preserves complete data array)
        data = json.loads(res.stdout)
        self.assertEqual(data, ["__name__", "instance", "job"])

    def test_routing_label_values_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": ["value-1", "value-2"],
        }
        # Verify URL encoding of the label name
        res = run_tq(["--label-values", "some/nested/label", "--end", "200", "up"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "GET")
        # Should call encoded path as GET and keep params in URL query string
        self.assertTrue(last_request_path.startswith("/api/v1/label/some%2Fnested%2Flabel/values?"))

        qs = urllib.parse.parse_qs(urllib.parse.urlparse(last_request_path).query)
        self.assertEqual(qs.get("match[]"), ["up"])
        self.assertEqual(qs.get("end"), ["200"])
        self.assertNotIn("start", qs)

        # Check normalization
        data = json.loads(res.stdout)
        self.assertEqual(data, ["value-1", "value-2"])

    def test_routing_stores_query(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": [
                {
                    "name": "store-1",
                    "minTime": 100,
                    "maxTime": 200,
                    "type": "sidecar",
                }
            ],
        }
        res = run_tq(["--stores"])
        self.assertEqual(res.returncode, 0)
        self.assertEqual(last_request_method, "GET")
        # Stores has NO query parameters or ? prefix
        self.assertEqual(last_request_path, "/api/v1/stores")

        # Check normalization (stores preserves the complete data structure unchanged)
        data = json.loads(res.stdout)
        self.assertEqual(len(data), 1)
        self.assertEqual(data[0]["name"], "store-1")

    def test_raw_response_handling(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": {"resultType": "vector", "result": [{"value": [1, "1"]}]},
            "warnings": ["w1"],
            "infos": ["i1"],
        }
        res = run_tq(["--raw-response", "up"])
        self.assertEqual(res.returncode, 0)

        # Raw response must contain the complete payload envelope
        data = json.loads(res.stdout)
        self.assertEqual(data["status"], "success")
        self.assertIn("warnings", data)
        self.assertIn("infos", data)

        # Raw mode should not duplicate warnings/infos to stderr
        self.assertNotIn("Warning: w1", res.stderr)
        self.assertNotIn("Info: i1", res.stderr)

    def test_normalized_warnings_and_infos(self):
        global mock_response_payload
        mock_response_payload = {
            "status": "success",
            "data": {"resultType": "vector", "result": []},
            "warnings": ["warning_test"],
            "infos": ["info_test"],
        }
        res = run_tq(["up"])
        self.assertEqual(res.returncode, 0)
        self.assertIn("Warning: warning_test", res.stderr)
        self.assertIn("Info: info_test", res.stderr)

    def test_response_validation_non_object_top_level(self):
        global mock_response_payload
        mock_response_payload = []
        res = run_tq(["up"])
        self.assertNotEqual(res.returncode, 0)
        self.assertIn("Invalid API response: expected a JSON object", res.stderr)

    def test_http_error_envelope_handling_normalized(self):
        global mock_response_payload, mock_response_status_code
        mock_response_status_code = 422
        mock_response_payload = {
            "status": "error",
            "errorType": "execution",
            "error": "bad query",
        }
        res = run_tq(["up"])
        self.assertNotEqual(res.returncode, 0)
        self.assertIn("Query error: execution: bad query", res.stderr)

    def test_http_error_envelope_handling_raw(self):
        global mock_response_payload, mock_response_status_code
        mock_response_status_code = 422
        mock_response_payload = {
            "status": "error",
            "errorType": "execution",
            "error": "bad query",
        }
        res = run_tq(["--raw-response", "up"])
        self.assertNotEqual(res.returncode, 0)
        
        # Raw mode outputs raw envelope on stdout
        data = json.loads(res.stdout)
        self.assertEqual(data["status"], "error")
        self.assertEqual(data["errorType"], "execution")
        self.assertEqual(data["error"], "bad query")

        # Stderr must not contain duplicate Query error string
        self.assertNotIn("Query error:", res.stderr)

    def test_http_error_with_non_json_body(self):
        global mock_response_payload, mock_response_status_code
        mock_response_status_code = 502
        mock_response_payload = "Bad Gateway"
        res = run_tq(["up"])
        self.assertNotEqual(res.returncode, 0)
        self.assertIn("HTTP 502: Bad Gateway", res.stderr)

    def test_http_error_with_malformed_json(self):
        global mock_response_payload, mock_response_status_code
        mock_response_status_code = 400
        mock_response_payload = "{invalid_json}"
        res = run_tq(["up"])
        self.assertNotEqual(res.returncode, 0)
        self.assertIn("HTTP 400: {invalid_json}", res.stderr)

    def test_legacy_form_compatibility(self):
        # Explicitly verify legacy forms: tq '<promql>', tq --range '<promql>', tq --series '<selector>', tq --raw-response '<promql>'
        global mock_response_payload
        mock_response_payload = {"status": "success", "data": {"resultType": "vector", "result": []}}

        res1 = run_tq(["up"])
        self.assertEqual(res1.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query")

        res2 = run_tq(["--range", "up"])
        self.assertEqual(res2.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/query_range")

        mock_response_payload = {"status": "success", "data": []}
        res3 = run_tq(["--series", "up"])
        self.assertEqual(res3.returncode, 0)
        self.assertEqual(last_request_method, "POST")
        self.assertEqual(last_request_path, "/api/v1/series")

        res4 = run_tq(["--raw-response", "up"])
        self.assertEqual(res4.returncode, 0)


if __name__ == "__main__":
    unittest.main()
