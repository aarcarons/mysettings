#!/usr/bin/env python3

import argparse
import json
import os
import signal
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# Restore default Unix SIGPIPE behavior for pipelines (e.g. | head)
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

DESCRIPTION = """\
Query a Thanos/Prometheus API endpoint and print JSON.

AI:
  Run the user's requested tq command directly. Configuration or connectivity
  failures will be reported by that invocation.
"""

HELP_OUTPUT_TEXT = r"""Detailed Output Format and Recipes for tq

1. Response Normalization:
   By default, tq strips the outer Prometheus envelope:
   Raw:       {"status": "success", "data": {"resultType": "vector", "result": [...]}}
   Normalized: [...] (the array of results directly)

   This enables clean downstream piping into jq, e.g.:
     tq '<promql>' | jq '.[].metric'

2. Sample Values and Floating-Point Special Cases:
   - Timestamps are Unix timestamps represented as JSON numbers.
   - Prometheus encodes sample values as JSON strings. This also permits special
     floating-point values such as "NaN", "+Inf", and "-Inf", which JSON numbers
     cannot represent.
   - If converting values in jq, use 'tonumber' for ordinary numeric values; special
     values such as "NaN" and infinities require separate handling:
     tq '<promql>' | jq '.[].value[1] | tonumber'

3. Common jq Recipes:
   - Extracting all metrics:
     tq '<promql>' | jq '.[].metric'

   - Inspecting range query values:
     tq --range '<promql>' | jq '.[].values'

   - Format instance/value pairs:
     tq '<promql>' | jq -r '.[] | "\(.metric.instance): \(.value[1])"'
"""


class OutputHelpAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        sys.stdout.write(HELP_OUTPUT_TEXT)
        parser.exit()


parser = argparse.ArgumentParser(
    description=DESCRIPTION,
    formatter_class=argparse.RawTextHelpFormatter,
    epilog="""\
Output:
  Instant       [{"metric": {...}, "value":  [<timestamp>, "<value>"]}, ...]
  Range         [{"metric": {...}, "values": [[<timestamp>, "<value>"], ...]}, ...]
  Series        [{"__name__": "...", "<label>": "..."}, ...]

  Prometheus's response envelope is removed by default.
  Sample values are strings; timestamps are numbers.
  Use --raw-response to print the complete API response.

Examples:
  tq '<promql>'                                  # Instant query
  tq --range '<promql>'                          # Last 1h, 1m resolution
  tq --range --step 5m '<promql>'                # Last 1h, 5m resolution
  tq --series '<series-selector>'                # Series metadata
""",
)

parser.add_argument(
    "query",
    nargs="+",
    help="PromQL query or series selector",
)

mode = parser.add_mutually_exclusive_group()
mode.add_argument(
    "--range",
    action="store_true",
    help="Perform a range query",
)
mode.add_argument(
    "--series",
    action="store_true",
    help="Perform a series metadata query",
)

parser.add_argument(
    "--start",
    help="Start time (with --range or --series; RFC3339 or Unix timestamp)",
)
parser.add_argument(
    "--end",
    help="End time (with --range or --series; RFC3339 or Unix timestamp)",
)
parser.add_argument(
    "--step",
    help="Range query resolution (with --range; default: 1m)",
)
parser.add_argument(
    "--raw-response",
    action="store_true",
    help="Print the complete Prometheus/Thanos API response envelope",
)
parser.add_argument(
    "--help-output",
    action=OutputHelpAction,
    nargs=0,
    help="Show detailed output examples, formats, and jq recipes",
)

# Bare `tq` should show useful help rather than only a missing-argument error.
if len(sys.argv) == 1:
    parser.print_help()
    sys.exit(2)

args = parser.parse_args()

# Validate argument relationships
if args.step and not args.range:
    parser.error("--step requires --range")

if args.start and not (args.range or args.series):
    parser.error("--start requires --range or --series")

if args.end and not (args.range or args.series):
    parser.error("--end requires --range or --series")

base_url = os.environ.get("THANOS_URL")
if not base_url:
    parser.error("THANOS_URL environment variable is not defined")

if not base_url.startswith(("http://", "https://")):
    parser.error("THANOS_URL must start with http:// or https://")

query = " ".join(args.query)
now = int(time.time())

if args.series:
    endpoint = "/api/v1/series"
    params = {
        "match[]": query,
        "start": args.start,
        "end": args.end,
    }
elif args.range:
    endpoint = "/api/v1/query_range"
    params = {
        "query": query,
        "start": args.start or now - 3600,
        "end": args.end or now,
        "step": args.step or "1m",
    }
else:
    endpoint = "/api/v1/query"
    params = {"query": query}

params = {k: v for k, v in params.items() if v is not None}
url = f"{base_url.rstrip('/')}{endpoint}?{urllib.parse.urlencode(params)}"

try:
    with urllib.request.urlopen(url, timeout=30) as response:
        payload = json.loads(response.read())

    # Diagnostics on stderr (only for normalized mode to prevent duplicate output)
    if not args.raw_response:
        for warning in payload.get("warnings", []):
            print(f"Warning: {warning}", file=sys.stderr)

        for info in payload.get("infos", []):
            print(f"Info: {info}", file=sys.stderr)

    is_error = payload.get("status") == "error"

    if args.raw_response:
        print(json.dumps(payload, indent=2))
        if is_error:
            sys.exit(1)
    else:
        if is_error:
            sys.exit(
                f"Query error: {payload.get('errorType', 'unknown')}: "
                f"{payload.get('error', 'unknown error')}"
            )

        data = payload.get("data", {})
        if isinstance(data, dict):
            data = data.get("result", data)

        print(json.dumps(data, indent=2))

except urllib.error.HTTPError as error:
    try:
        body = error.read().decode()
    except (OSError, UnicodeDecodeError):
        body = ""

    if args.raw_response:
        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            pass
        else:
            print(json.dumps(payload, indent=2))
            sys.exit(1)

    sys.exit(f"HTTP {error.code}: {body}")
except urllib.error.URLError as error:
    sys.exit(f"Connection error: {error.reason}")
except json.JSONDecodeError as error:
    sys.exit(f"Invalid JSON response: {error}")
except KeyboardInterrupt:
    sys.exit(130)
